{
  "name": "@local/quota-windows",
  "version": "1.15.0",
  "private": true,
  "type": "module",
  "description": "Shows the subscription and balance status of every added provider with a supported usage or balance API.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs/*.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "license": "MIT"
}
